# Environment Variables for Fortran² Website
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# Application URL for authentication callbacks
# For local development: http://localhost:3000
# For production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Secret for encrypting JWT tokens
# Generate with: openssl rand -base64 32
# IMPORTANT: Use a strong, random secret in production
NEXTAUTH_SECRET=your-nextauth-secret-key

# =============================================================================
# GITHUB INTEGRATION
# =============================================================================

# GitHub Personal Access Token for higher API rate limits
# Create at: https://github.com/settings/tokens
# Required scopes: public_repo (for private repos add repo)
# Without this token, you get 60 requests/hour rate limit
# With this token, you get 5000 requests/hour rate limit
GITHUB_TOKEN=your-github-personal-access-token

# =============================================================================
# GITHUB OAUTH (NextAuth.js)
# =============================================================================

# GitHub OAuth Application credentials
# Create at: https://github.com/settings/developers
# - Click "New OAuth App"
# - Homepage URL: http://localhost:3000 (development) or https://your-domain.com (production)
# - Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=your-github-oauth-client-id
GITHUB_SECRET=your-github-oauth-client-secret

# =============================================================================
# EMAIL SERVICES
# =============================================================================

# Mailchimp Configuration
# Get your API key from Mailchimp dashboard > Account > Extras > API keys
MAILCHIMP_API_KEY=your-mailchimp-api-key

# Get your Audience ID from Mailchimp dashboard > Audience > Settings > Audience name and defaults
MAILCHIMP_AUDIENCE_ID=your-mailchimp-audience-id

# SendGrid Configuration (alternative to Mailchimp)
# Get your API key from SendGrid dashboard > Settings > API Keys
SENDGRID_API_KEY=your-sendgrid-api-key

# Email address used as the sender for newsletter confirmations
NEWSLETTER_FROM_EMAIL=noreply@fortran2.org

# =============================================================================
# ANALYTICS
# =============================================================================

# Enable/disable analytics globally
# Default: true in production, false in development
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Google Analytics Measurement ID (e.g., G-XXXXXXXXXX)
# Get from: https://analytics.google.com
NEXT_PUBLIC_ANALYTICS_ID=G-XXXXXXXXXX

# Enable Vercel Analytics
# Requires @vercel/analytics package
NEXT_PUBLIC_VERCEL_ANALYTICS=true

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Public API URL for client-side requests
# Default: https://api.fortran2.io
NEXT_PUBLIC_API_URL=https://api.fortran2.io

# API Key for server-side API calls (if needed)
API_KEY=your-api-key

# =============================================================================
# DATABASE (if using)
# =============================================================================

# Database connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/fortran2

# =============================================================================
# REDIS (if using for caching)
# =============================================================================

# Redis connection string
# REDIS_URL=redis://localhost:6379

# =============================================================================
# THIRD-PARTY SERVICES
# =============================================================================

# Sentry (error tracking)
# SENTRY_DSN=your-sentry-dsn

# LogRocket (session replay)
# LOGROCKET_APP_ID=your-logrocket-app-id

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
#
# For local development without email services:
# - The newsletter will log to console instead of sending emails
# - This is intentional for development safety
#
# For testing GitHub API:
# - Without GITHUB_TOKEN, you get 60 requests/hour rate limit
# - With GITHUB_TOKEN, you get 5000 requests/hour rate limit
# - If GitHub API fails, the app falls back to mock data
#
# Environment Detection:
# - Set NODE_ENV=development for local development
# - Set NODE_ENV=production for production builds
#
# Security Best Practices:
# - Never commit .env.local to version control
# - Use strong, random secrets for NEXTAUTH_SECRET
# - Rotate secrets regularly
# - Use different secrets for development and production
# - Limit GitHub token scopes to minimum required
#
# Production Deployment:
# - Set all required variables in your deployment platform
# - Use environment variable management in Vercel/Netlify
# - Verify variables are set correctly before deployment
# - Test authentication flow after deployment
